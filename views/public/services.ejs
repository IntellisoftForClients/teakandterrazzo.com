<%- include('partials/head') %>
<section class="page-hero" id="hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span>Services</span>
    </nav>
    <h1>Interior Design Services</h1>
    <p class="page-intro">At Teak &amp; Terrazzo, we don’t just design interiors — we create spaces. Boutique design consultancy and complete turnkey execution for residential and light commercial projects in Hyderabad.</p>
  </div>
</section>

<section class="services page-content">
  <div class="container-wide">
    <div class="section-head reveal">
      <span class="pill">What We Offer</span>
      <h2 class="section-title">Core Services</h2>
    </div>
    <div class="services-list">
      <% services.forEach(function(service) { %>
        <a href="/services/<%= service.slug %>" class="service-card reveal">
          <div class="service-copy">
            <h3><%= service.title %></h3>
            <p><%= service.summary %></p>
            <span class="link-arrow">See More <img src="/assets/images/arrow.svg" alt="" /></span>
          </div>
          <div class="thumb"><img src="<%= service.imagePath %>" alt="<%= service.title %>" /></div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="page-content" style="padding-top:0;">
  <div class="container-wide">
    <div class="section-head reveal">
      <span class="pill">Full Scope</span>
      <h2 class="section-title">Everything we deliver</h2>
    </div>
    <div class="brief-grid reveal">
      <article class="brief-card">
        <h3>Design &amp; Planning</h3>
        <ul>
          <li>Interior Design Consultancy</li>
          <li>Space Planning</li>
          <li>2D Layouts &amp; 3D Visualizations</li>
          <li>Material Selection</li>
          <li>BOQ &amp; Cost Estimation</li>
        </ul>
      </article>
      <article class="brief-card">
        <h3>Fit-Out &amp; Craft</h3>
        <ul>
          <li>Modular Kitchens</li>
          <li>Wardrobes &amp; Storage Solutions</li>
          <li>Custom Furniture</li>
          <li>False Ceiling Systems</li>
          <li>Electrical &amp; Lighting Works</li>
          <li>Painting &amp; Wall Finishes</li>
          <li>Flooring Solutions</li>
          <li>Soft Furnishings &amp; Décor</li>
        </ul>
      </article>
      <article class="brief-card">
        <h3>Complete Turnkey Execution</h3>
        <ul>
          <li>Site Measurement</li>
          <li>Concept Design</li>
          <li>Procurement</li>
          <li>Site Supervision</li>
          <li>Quality Checks</li>
          <li>Final Installation</li>
          <li>Project Handover</li>
        </ul>
      </article>
    </div>
  </div>
</section>

