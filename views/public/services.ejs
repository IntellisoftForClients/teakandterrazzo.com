        <ul class="brief-tags">
          <li>Living Rooms</li>
          <li>Bedrooms</li>
          <li>Kitchens</li>
          <li>Dining Areas</li>
          <li>Bathrooms</li>
          <li>Home Offices</li>
          <li>Balconies</li>
          <li>Utility Areas</li>
          <li>Entertainment Rooms</li>
