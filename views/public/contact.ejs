<%- include('partials/head') %>
<section class="page-hero" id="hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span>Contact</span>
    </nav>
    <h1>Book an Interior Design Consultation</h1>
    <p class="page-intro">Tell us about your space in Hyderabad — we’ll get back within office hours.</p>
  </div>
</section>

<section class="page-content contact-page">
  <div class="container">
    <div class="contact-grid">
      <aside class="contact-info reveal">
        <span class="pill">Get in touch</span>
        <h2 class="contact-info-title">Studio details</h2>
        <p class="contact-info-lead">
          <%= settings.businessHours || '10:00 AM to 6:00 PM (IST)' %>
        </p>

        <ul class="contact-list">
          <li>
            <span class="contact-list-label">Address</span>
            <span class="contact-list-value"><%= settings.address %></span>
            <% if (settings.mapsUrl) { %>
              <a class="contact-inline-link" href="<%= settings.mapsUrl %>" target="_blank" rel="noopener">View on Maps</a>
            <% } %>
          </li>
          <li>
            <span class="contact-list-label">Phone</span>
            <span class="contact-list-value">
              <a href="tel:<%= settings.phone.replace(/[^\d+]/g,'') %>"><%= settings.phone %></a>
              <% if (settings.phoneSecondary) { %>
                <a href="tel:<%= settings.phoneSecondary.replace(/[^\d+]/g,'') %>"><%= settings.phoneSecondary %></a>
              <% } %>
            </span>
          </li>
          <li>
            <span class="contact-list-label">Email</span>
            <span class="contact-list-value">
              <a href="mailto:<%= settings.email %>"><%= settings.email %></a>
            </span>
          </li>
          <% if (settings.instagram) { %>
            <li>
              <span class="contact-list-label">Instagram</span>
              <span class="contact-list-value">
                <a href="<%= settings.instagram %>" target="_blank" rel="noopener">Follow our studio</a>
              </span>
            </li>
          <% } %>
        </ul>

        <% if (settings.whatsapp) { %>
          <a class="btn btn-dark contact-whatsapp" href="<%= settings.whatsapp %>" target="_blank" rel="noopener">
            Chat on WhatsApp
            <span class="btn-arrow"><img src="/assets/images/arrow-dark.svg" alt="" /></span>
          </a>
        <% } %>
      </aside>

      <form class="contact-form reveal" id="contactForm">
        <div class="contact-form-head">
          <h2>Send a message</h2>
          <p>Share a few details and we’ll follow up with next steps.</p>
        </div>

        <div class="form-row">
          <div>
            <label for="name">Name</label>
            <input id="name" name="name" type="text" required placeholder="Your name" autocomplete="name" />
          </div>
          <div>
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" placeholder="+91..." autocomplete="tel" />
          </div>
        </div>

        <div>
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required placeholder="you@email.com" autocomplete="email" />
        </div>

        <div class="form-row">
          <div>
            <label for="service">Project type</label>
            <input id="service" name="service" type="text" placeholder="e.g. Residential interiors" />
          </div>
          <div>
            <label for="budget">Budget</label>
            <input id="budget" name="budget" type="text" placeholder="e.g. ₹10 – 25 Lakh" />
          </div>
        </div>

        <div>
          <label for="timeline">Timeline</label>
          <input id="timeline" name="timeline" type="text" placeholder="e.g. 1 – 3 months" />
        </div>

        <div>
          <label for="message">Message</label>
          <textarea id="message" name="message" required placeholder="Project goals, space type, and any preferences..."></textarea>
        </div>

        <p id="contactMsg" class="contact-form-msg" role="status"></p>

        <button type="submit" class="btn btn-dark">
          Submit inquiry
          <span class="btn-arrow"><img src="/assets/images/arrow-dark.svg" alt="" /></span>
        </button>
      </form>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
