<%- include('partials/layout-start') %>
<div class="admin-top">
  <h1>Lead detail</h1>
  <a class="btn btn-ghost" href="/admin/leads">Back</a>
</div>
<div class="card">
  <p><strong>Name:</strong> <%= lead.name %></p>
  <p style="margin-top:10px;"><strong>Email:</strong> <a href="mailto:<%= lead.email %>"><%= lead.email %></a></p>
  <p style="margin-top:10px;"><strong>Phone:</strong> <%= lead.phone || '—' %></p>
  <p style="margin-top:10px;"><strong>Project type:</strong> <%= lead.service %></p>
  <p style="margin-top:10px;"><strong>Budget:</strong> <%= lead.budget || '—' %></p>
  <p style="margin-top:10px;"><strong>Timeline:</strong> <%= lead.timeline || '—' %></p>
  <p style="margin-top:10px;"><strong>Status:</strong> <span class="badge <%= lead.status %>"><%= lead.status %></span></p>
  <p style="margin-top:10px;"><strong>Received:</strong> <%= lead.createdAt.toLocaleString() %></p>
  <p style="margin-top:18px;line-height:1.6;"><%= lead.message %></p>
  <div class="row-actions" style="margin-top:20px;">
    <form method="post" action="/admin/leads/<%= lead.id %>/status">
      <input type="hidden" name="status" value="new" />
      <button class="btn btn-ghost btn-sm" type="submit">Mark new</button>
    </form>
    <form method="post" action="/admin/leads/<%= lead.id %>/status">
      <input type="hidden" name="status" value="read" />
      <button class="btn btn-ghost btn-sm" type="submit">Mark read</button>
    </form>
    <form method="post" action="/admin/leads/<%= lead.id %>/status">
      <input type="hidden" name="status" value="archived" />
      <button class="btn btn-dark btn-sm" type="submit">Archive</button>
    </form>
    <form method="post" action="/admin/leads/<%= lead.id %>/delete" onsubmit="return confirm('Delete this lead?');">
      <button class="btn btn-danger btn-sm" type="submit">Delete</button>
    </form>
  </div>
</div>
<%- include('partials/layout-end') %>
