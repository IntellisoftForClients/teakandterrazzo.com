{
  "name": "teak-and-terrazzo",
  "version": "1.0.0",
  "description": "Teak & Terrazzo interior design agency — fullstack CMS",
  "main": "server/index.js",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate deploy",
    "db:push": "node ./node_modules/prisma/build/index.js db push",
    "seed": "node prisma/seed.js",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "setup": "npm run db:up && npm run db:push && npm run seed"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.2",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "method-override": "^3.0.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "prisma": "^6.16.2"
  }
}
